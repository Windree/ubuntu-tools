#!/usr/bin/env fish
# tags: #common-functions #functions #log

function _term_supports_formatting
    # 1. Fail immediately if TERM is empty or dumb
    if test -z "$TERM" -o "$TERM" = "dumb"
        return 1
    end

    # 2. Check if stdout or stderr is attached to a terminal
    if isatty stdout; or isatty stderr
        return 0
    end

    return 1
end


function log --description "Print a formatted log message with an icon"
    if test (count $argv) -lt 2
        echo "Usage: "(status current-function)" <info|ok|warn(ing)|err(or)> <template> [args...]" >&2
        return 1
    end

    set -l level $argv[1]
    set -l argv $argv[2..-1]

    switch $level
        case info
            log_info $argv
        case ok success
            log_ok $argv
        case warn warning
            log_warning $argv
        case err error
            log_error $argv
        case '*'
            log_message $argv
    end
end

function log_error --description "Print a formatted log message with an icon"
    if test (count $argv) -lt 1
        echo "Usage: "(status current-function)" <template> [args...]" >&2
        return 1
    end
    set -l template $argv[1]
    set argv $argv[2..]
    if _term_supports_formatting
        # Bold Red text for errors
        printf '%s❌ Error: ' (set_color -o red)
        printf "%s$template" "" $argv
        printf '%s\n' (set_color normal)
    else
        printf "Error: $template\n" $argv
    end
end

