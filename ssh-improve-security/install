#!/usr/bin/env sh
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
error=0

cp -r "$SCRIPT_DIR/files"/* / || error=1

output=$(cd "$SCRIPT_DIR/files" && find etc -type f)
[ -z "$output" ] && error=1
while IFS= read -r file; do
    chown root:root "/$file" && \
    chmod 0644 "/$file" || \
    error=1
done <<EOF
$output
EOF

sshd -t || error 1

[ $error -ne 0 ] && printf 'ERROR: Failed to install\n' >&2 && exit 1
printf 'OK. Reboot or "systemctl restart sshd" required\n' >&2
exit 0
