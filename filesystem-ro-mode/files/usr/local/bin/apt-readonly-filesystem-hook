#!/usr/bin/env -S fish --no-config
#!tags: #apt #ro-filesystem

set -l SCRIPT_DIR (cd (dirname (status filename)); and pwd)
source "$SCRIPT_DIR/functions/log"

# Switch replaces the classic case syntax
switch "$argv[1]"
    case pre
        # Run the command directly in the condition. 
        # If it returns a non-zero exit status, the block triggers.
        if not "$SCRIPT_DIR/fs-manager" enable-rw
          log_error "Failed to switch all filesystem to read-write mode before installation!"
          exit 1
        end
        log_info "Read-only protection disabled. Continue installation."

    case post
        set -l i 60
        # In Fish, while loops evaluate standard commands or expressions using 'test'
        while test $i -ge 0
          log_info "Reboot to read-only filesystem mode in %d seconds" "$i"
          set i (math "$i - 1") # Use native 'math' for math calculations
          sleep 1
        end
        log_info "Rebooting"
        systemctl reboot -i

    case '*'
        # Fish uses explicit quotes around the wildcard asterisk for default cases
        echo "Usage: $0 pre|post"
        exit 1
end

exit 0
