#!/usr/bin/env sh

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

case "$1" in
  pre)
    if ! "$SCRIPT_DIR/fs-manager" switch-rw; then
      echo "ERROR: Failed to switch all filesystem to read-write mode before installation!"
      exit 1
    fi
    exit 0
  ;;
  post)
    i=60
    while [ "$i" -ge 0 ]; do
      printf "Reboot to read-only filesystem mode in %d seconds\n" "$i"
      i=$((i - 1))
      sleep 1
    done
    systemctl reboot -i
  ;;
  *)
    echo "Usage: $0 pre|post"
    exit 1
  ;;
esac
exit 0
