#!/usr/bin/env -S fish --no-config
#!tags: #apt #ro-filesystem

set -l SCRIPT_DIR (cd (dirname (status filename)); and pwd)
source "$SCRIPT_DIR/functions/log"
source "$SCRIPT_DIR/functions/get-disks-mountpoints"
source "$SCRIPT_DIR/functions/filter-mountpoint"

# Delay between end of installation and reboot
set -g reboot_after_install_sec 300

set -g filename (basename (status filename))
set -g reboot_required_file /run/$filename.require-restart

switch "$argv[1]"
    case pre
        set -l ro_output (get_disks_mountpoints | filter_mountpoint option ro)
        if test -z "$ro_output"
            exit 0
        end
        if not "$SCRIPT_DIR/fs-manager" enable-rw
            log_error 'Failed to switch all filesystem to read-write mode before installation!' >&2
            exit 1
        end
        log_info 'Read-only protection disabled. Continue installation.' >&2
        if ! touch "$reboot_required_file"
            log_error 'Failed to set scheduled reboot flag!' >&2
        end
        log_info 'System will reboot to read-only filesystem mode in %s second(s) after the installation completed.' $reboot_after_install_sec >&2
        exit 0
    case post
        if not test -f "$reboot_required_file"
            exit 0
        end
        rm -f "$reboot_required_file"
        if test -r /dev/tty; and sh -c 'true < /dev/tty' 2>/dev/null
            log_warning "Press 'c' within 10 seconds to cancel automatic reboot to read-only filesystem mode..." >/dev/tty
            bash -c 'read -r -n 1 -t 10 k </dev/tty && [[ "$k" == [cC] ]]' 2>/dev/null
            set -l cancel_status $status
            printf '\n' >/dev/tty
            if test $cancel_status -eq 0
                log_warning "Reboot canceled by user." >&2
                exit 0
            end
        end
        set -l unit apt-hook-reboot
        if not systemd-run --on-active="$reboot_after_install_sec" --unit="$unit" --description="Reboot to read-only filesystem after apt installation" systemctl reboot
            log_error 'Failed to schedule automatic system reboot!' >&2
            exit 1
        end
        log_info 'System will reboot to read-only filesystem mode in %s second(s).' $reboot_after_install_sec >&2
        log_info 'Run following command to stop: sudo systemctl stop %s.timer' $unit
        exit 0
    case '*'
        log_info "Usage: %s pre|post" (basename (status filename)) >&2
        exit 1
end
