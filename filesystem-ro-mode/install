#!/usr/bin/env sh
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
error=0

cp -vr "$SCRIPT_DIR/files"/* / || error=1

output=$(cd "$SCRIPT_DIR/files" && find etc -type f)
[ -z "$output" ] && error=1
while IFS= read -r file; do
    chown -v root:root "/$file" && \
    chmod -v 0644 "/$file" || \
    error=1
done <<EOF
$output
EOF

output=$(cd "$SCRIPT_DIR/files" && find usr -type f)
[ -z "$output" ] && error=1
while IFS= read -r file; do
    chown -v root:root "/$file" && \
    chmod -v 0755 "/$file" || \
    error=1
done <<EOF
$output
EOF

update-grub || error=1

[ $error -ne 0 ] && printf 'Failed to install\n' >&2 && exit 1
echo "Installed. Reboot to apply changes."
exit 0
