#!/usr/bin/env sh
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
error=0

"$SCRIPT_DIR/../functions-common/install" || error=1

rsync -ac --no-links --info=NAME --no-perms --no-owner --no-group "$SCRIPT_DIR/files/" / || error=1 || error=1

output=$(cd "$SCRIPT_DIR/files" && find etc -type f)
[ -z "$output" ] && error=1
while IFS= read -r file; do
    dir=$(dirname -- "/$file") \
    && chown -v root:root "/$file" "$dir" \
    && chmod -v 0644 "/$file" \
    && chmod -v 0755 "$dir" \
    || error=1
done <<EOF
$output
EOF

output=$(cd "$SCRIPT_DIR/files" && find usr -type d)
[ -z "$output" ] && error=1
while IFS= read -r file; do
    dir=$(dirname -- "/$file") \
    && chown -v root:root "/$file" "$dir" \
    && chmod -v 0755 "/$file" \
    && chmod -v 0755 "$dir" \
    || error=1
done <<EOF
$output
EOF

if command -v update-grub >/dev/null 2>&1;then
    update-grub || error=1
fi

[ $error -ne 0 ] && printf 'Failed to install\n' >&2 && exit 1
echo "Installed. Reboot to apply changes."
exit 0
