#!/usr/bin/env sh
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

cp "$SCRIPT_DIR/usr/local/bin/apt-readonly-filesystem-hook" /usr/local/bin/ && \
chown root:root /usr/local/bin/apt-readonly-filesystem-hook && \
chmod 0755 /usr/local/bin/apt-readonly-filesystem-hook && \
cp "$SCRIPT_DIR/usr/local/bin/rw" /usr/local/bin/ && \
chown root:root /usr/local/bin/rw && \
chmod 0755 /usr/local/bin/rw && \
cp "$SCRIPT_DIR/etc/apt/apt.conf.d/99z-readonly-filesystem-hooks" /etc/apt/apt.conf.d/ && \
chown root:root /etc/apt/apt.conf.d/99z-readonly-filesystem-hooks && \
chmod 0755 /etc/apt/apt.conf.d/99z-readonly-filesystem-hooks && \
echo "Complete" || \
echo "Error"
